@prefix dct: <http://purl.org/dc/terms/> .
@prefix linter: <https://w3id.org/warsampo-linter#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

linter:IllTypedLiteralShape
    a sh:NodeShape ;
    sh:targetNode linter:auditTarget ;
    sh:severity sh:Violation ;
    sh:message "A literal does not have a valid lexical form for its XSD datatype." ;
    dct:source <https://www.w3.org/TR/xmlschema11-2/> ;
    linter:layer linter:CoreLayer ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:select """
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?path ?value ?message
            WHERE {
              ?subject ?path ?value .
              FILTER(isLiteral(?value))
              BIND(datatype(?value) AS ?datatype)
              FILTER(?datatype IN (xsd:date, xsd:dateTime, xsd:integer, xsd:decimal, xsd:double, xsd:boolean))
              FILTER(
                (?datatype = xsd:date && !REGEX(STR(?value), "^-?[0-9]{4,}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])(Z|[+-][0-9]{2}:[0-9]{2})?$")) ||
                (?datatype = xsd:dateTime && !REGEX(STR(?value), "^-?[0-9]{4,}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?$")) ||
                (?datatype = xsd:integer && !REGEX(STR(?value), "^[+-]?[0-9]+$")) ||
                (?datatype = xsd:decimal && !REGEX(STR(?value), "^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)$")) ||
                (?datatype = xsd:double && !REGEX(STR(?value), "^([+-]?(([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?|INF)|NaN)$")) ||
                (?datatype = xsd:boolean && !REGEX(STR(?value), "^(true|false|0|1)$"))
              )
              BIND(CONCAT("Ill-typed ", STR(?datatype), " literal on ", STR(?subject)) AS ?message)
            }
        """ ;
    ] .
