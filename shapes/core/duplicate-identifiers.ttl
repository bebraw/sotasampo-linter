@prefix dct: <http://purl.org/dc/terms/> .
@prefix linter: <https://w3id.org/warsampo-linter#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

linter:DuplicateIdentifierShape
    a sh:NodeShape ;
    sh:targetSubjectsOf dct:identifier ;
    sh:severity sh:Warning ;
    sh:message "The same DCTERMS identifier is assigned to more than one resource." ;
    dct:source <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/terms/identifier/> ;
    linter:layer linter:StructuralLayer ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:select """
            PREFIX dct: <http://purl.org/dc/terms/>
            SELECT DISTINCT $this (dct:identifier AS ?path) ?value ?message
            WHERE {
              $this dct:identifier ?value .
              ?other dct:identifier ?value .
              FILTER(?other != $this)
              BIND(CONCAT("Identifier is also used by ", STR(?other)) AS ?message)
            }
        """ ;
    ] .
