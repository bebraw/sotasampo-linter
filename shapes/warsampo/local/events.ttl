@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix linter: <https://w3id.org/warsampo-linter#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix wsc: <http://ldf.fi/schema/warsa/> .

linter:BirthPersonNodeShape
    a sh:NodeShape ;
    sh:targetClass wsc:Birth ;
    sh:property linter:BirthPersonPropertyShape ;
    dct:source linter:BirthPersonRequirement ;
    linter:layer linter:DomainLayer .

linter:BirthPersonPropertyShape
    a sh:PropertyShape ;
    sh:path crm:P98_brought_into_life ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "A WarSampo birth event must identify exactly one person brought into life." ;
    dct:source linter:BirthPersonRequirement ;
    linter:layer linter:DomainLayer .

linter:DeathPersonNodeShape
    a sh:NodeShape ;
    sh:targetClass wsc:Death ;
    sh:property linter:DeathPersonPropertyShape ;
    dct:source linter:DeathPersonRequirement ;
    linter:layer linter:DomainLayer .

linter:DeathPersonPropertyShape
    a sh:PropertyShape ;
    sh:path crm:P100_was_death_of ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "A WarSampo death event must identify exactly one deceased person." ;
    dct:source linter:DeathPersonRequirement ;
    linter:layer linter:DomainLayer .

linter:UnitJoiningNodeShape
    a sh:NodeShape ;
    sh:targetClass wsc:UnitJoining ;
    sh:property linter:UnitJoiningChildPropertyShape ;
    sh:property linter:UnitJoiningParentPropertyShape ;
    sh:severity sh:Violation ;
    sh:message "A military unit cannot join itself." ;
    dct:source linter:UnitJoiningRequirement ;
    linter:layer linter:DomainLayer ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A military unit cannot join itself." ;
        sh:select """
            PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
            SELECT $this (crm:P144_joined_with AS ?path) ?value
            WHERE {
              $this crm:P143_joined ?value ; crm:P144_joined_with ?value .
            }
        """ ;
    ] .

linter:UnitJoiningChildPropertyShape
    a sh:PropertyShape ;
    sh:path crm:P143_joined ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "A unit-joining event must identify exactly one joining unit." ;
    dct:source linter:UnitJoiningRequirement ;
    linter:layer linter:DomainLayer .

linter:UnitJoiningParentPropertyShape
    a sh:PropertyShape ;
    sh:path crm:P144_joined_with ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "A unit-joining event must identify exactly one receiving unit." ;
    dct:source linter:UnitJoiningRequirement ;
    linter:layer linter:DomainLayer .

linter:MedalAwardingNodeShape
    a sh:NodeShape ;
    sh:targetClass wsc:MedalAwarding ;
    sh:property linter:MedalAwardingMedalPropertyShape ;
    sh:property linter:MedalAwardingRecipientPropertyShape ;
    dct:source linter:MedalAwardingRequirement ;
    linter:layer linter:DomainLayer .

linter:MedalAwardingMedalPropertyShape
    a sh:PropertyShape ;
    sh:path crm:P141_assigned ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "A medal-awarding event must assign exactly one medal." ;
    dct:source linter:MedalAwardingRequirement ;
    linter:layer linter:DomainLayer .

linter:MedalAwardingRecipientPropertyShape
    a sh:PropertyShape ;
    sh:path crm:P11_had_participant ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "A medal-awarding event must identify exactly one recipient." ;
    dct:source linter:MedalAwardingRequirement ;
    linter:layer linter:DomainLayer .
