@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix linter: <https://w3id.org/warsampo-linter#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

linter:InternalReferenceShape
    a sh:NodeShape ;
    sh:targetNode linter:auditTarget ;
    sh:severity sh:Warning ;
    sh:message "An internal WarSampo IRI is referenced but has no description in the selected union graph." ;
    dct:source <https://w3id.org/warsampo-linter/requirements/internal-reference> ;
    linter:layer linter:IntegrationLayer ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:select """
            PREFIX linter: <https://w3id.org/warsampo-linter#>
            SELECT DISTINCT $this ?path ?value ?message
            WHERE {
              $this linter:internalNamespace ?namespace .
              ?subject ?path ?value .
              FILTER(isIRI(?value))
              FILTER(STRSTARTS(STR(?value), STR(?namespace)))
              FILTER NOT EXISTS { ?value ?descriptionProperty ?descriptionValue }
              BIND(CONCAT("Unresolved internal IRI ", STR(?value), " referenced by ", STR(?subject)) AS ?message)
            }
        """ ;
    ] .

linter:EventParticipantTypeShape
    a sh:NodeShape ;
    sh:targetSubjectsOf crm:P11_had_participant ;
    sh:severity sh:Warning ;
    sh:message "A WarSampo event participant must resolve to a typed person or military unit." ;
    dct:source <https://w3id.org/warsampo-linter/requirements/event-participant> ;
    linter:layer linter:IntegrationLayer ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:select """
            PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
            PREFIX wsc: <http://ldf.fi/schema/warsa/>
            SELECT DISTINCT $this (crm:P11_had_participant AS ?path) ?value
            WHERE {
              $this crm:P11_had_participant ?value .
              FILTER(STRSTARTS(STR(?value), "http://ldf.fi/warsa/actors/"))
              FILTER NOT EXISTS {
                ?value a ?actorType .
                VALUES ?actorType { wsc:Person wsc:MilitaryUnit }
              }
            }
        """ ;
    ] .
