@prefix dct: <http://purl.org/dc/terms/> .
@prefix linter: <https://w3id.org/warsampo-linter#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

linter:DuplicateIdentifierShape
    a sh:NodeShape ;
    sh:targetNode linter:auditTarget ;
    sh:severity sh:Warning ;
    sh:message "The same DCTERMS identifier is assigned to more than one resource." ;
    dct:source <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/terms/identifier/> ;
    linter:layer linter:IntegrationLayer ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:select """
            PREFIX dct: <http://purl.org/dc/terms/>
            SELECT DISTINCT $this (dct:identifier AS ?path) ?value ?message
            WHERE {
              {
                SELECT ?value (COUNT(DISTINCT ?resource) AS ?resourceCount)
                WHERE { ?resource dct:identifier ?value }
                GROUP BY ?value
                HAVING(COUNT(DISTINCT ?resource) > 1)
              }
              BIND(CONCAT("Identifier is shared by ", STR(?resourceCount), " resources") AS ?message)
            }
        """ ;
    ] .
